# Copy this file to .env and fill it in. Never commit .env.

# From https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Your own Discord user ID (Settings -> Advanced -> Developer Mode, then
# right-click yourself -> Copy User ID). Only this account can control the PC.
DISCORD_OWNER_ID=

# --- optional -----------------------------------------------------------------

COMMAND_PREFIX=!

# Where Claude and the shell start. Defaults to your home directory.
# e.g. DEFAULT_WORKDIR=C:\Users\you\projects
DEFAULT_WORKDIR=

# Claude Code model alias (opus, sonnet, haiku, fable) or full ID. Blank = your
# account default. `!model` overrides this per conversation at runtime.
CLAUDE_MODEL=

# low | medium | high | xhigh | max. Blank defaults to `medium`, rather than
# Claude Code's own `xhigh` — that default is tuned for long autonomous coding
# runs, and effort drives thinking tokens, which bill as output. Raise it per
# conversation with `!effort` when a task actually warrants it.
CLAUDE_EFFORT=

# Keep the Claude Code system prompt byte-identical between invocations.
#
# Every prompt spawns a fresh `claude -p --resume`, which Claude Code treats as
# a *sequential session*. Its system prompt embeds the cwd, platform, shell, OS
# version, memory paths and a git status snapshot (branch + recent commits) —
# so a commit, a branch switch, or a `!cd` between two prompts invalidates the
# cached prefix and re-reads the entire conversation at full input price. This
# moves those sections into the first user message, which is replayed verbatim
# on resume. Measured on this repo: ~50% less cache re-creation on a resume
# that followed a commit, plus the prefix becomes shareable across directories.
#
# Tradeoff: Claude still sees cwd and environment, but as user-turn context
# rather than system-prompt context, so it weighs them slightly less heavily.
CLAUDE_STABLE_PREFIX=true

# Hard per-turn spend ceiling in dollars, passed to --max-budget-usd. A runaway
# agentic loop is the one failure mode that can burn a whole 5-hour window on a
# single prompt. 0 disables the cap.
CLAUDE_MAX_BUDGET_USD=0

# bypassPermissions runs tools without asking — required for unattended use.
# Other options: acceptEdits, auto, plan, manual, dontAsk
CLAUDE_PERMISSION_MODE=bypassPermissions

# Seconds before a Claude turn is force-stopped. Browser work is slow — leave
# this generous if you use the Chrome MCP server.
CLAUDE_TIMEOUT=1800

# "Claude in Chrome" — let Claude drive the Chrome you already use, with the
# sites you are already signed into. Requires the Claude Code browser extension
# (run `claude` in a terminal and use /chrome to install it) and Chrome running.
#
# Ignored when an MCP browser server is configured below: `--chrome` and
# chrome-devtools-mcp are two complete, overlapping browser toolsets, and
# loading both doubles the browser tool definitions in every request while
# leaving Claude to guess which set to reach for. The MCP server wins.
CLAUDE_CHROME=true

# Whether *new* conversations start with browser tools loaded. Tool definitions
# live in the cached prefix of every request in a conversation, so a prompt that
# never browses still pays for them. Off means `!chrome on` opts a conversation
# in when it needs to open a page; `!chrome` shows the current state.
CLAUDE_CHROME_DEFAULT_ON=false

# MCP servers to hand Claude, as a JSON file. Blank looks for mcp.json next to
# bot.py; if that does not exist either, Claude runs with its built-in tools
# only. Copy mcp.json.example to mcp.json to enable browser control.
MCP_CONFIG=

# Seconds before a !sh / !cmd command is killed.
SHELL_TIMEOUT=180

# Send a screenshot automatically after every successful Claude turn.
AUTO_SCREENSHOT=true

# Treat messages that do not start with the prefix as Claude prompts.
BARE_MESSAGE_IS_PROMPT=true

# Upload ceiling in bytes. Discord free tier is 10 MiB; leave headroom.
MAX_UPLOAD_BYTES=7500000

# --- usage windows ------------------------------------------------------------

# DM you when the subscription's rolling 5-hour window resets. The check is a
# plain HTTPS GET against Anthropic's usage endpoint and costs no tokens.
WINDOW_WATCH=true

# On reset, fire one tiny prompt to open the next window immediately.
#
# The window is rolling: it starts at your first request and ends five hours
# later. Left alone it drifts to whenever you next happen to be at the keyboard.
# Anchoring pins it to a boundary you know, so a long session never runs into a
# ceiling that arrived at an unpredictable hour. Usage windows are shared across
# models, so a Haiku probe opens the same window Opus later draws on.
# Measured cost of one anchor: ~6.5k tokens (mostly cache reads), about $0.002.
WINDOW_WARM=true
WINDOW_WARM_MODEL=haiku

# Seconds between usage checks. The watcher tightens to 30s in the last ten
# minutes before a reset so the DM lands close to the event.
WINDOW_POLL_SECONDS=300
